# --- Virtuoso SPARQL endpoint ---
VIRTUOSO_HOST=localhost
VIRTUOSO_PORT=8890
VIRTUOSO_USER=dba
VIRTUOSO_PASSWORD=dba
VIRTUOSO_SPARQL_ENDPOINT=/sparql
VIRTUOSO_GRAPH_URI=http://demo.openlinksw.com/trucking-ontology-benchmark/graph

# --- LLM provider ---
# openai (default) | anthropic | custom (Ollama, vLLM, LiteLLM, etc.)
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
# LLM_BASE_URL=              # uncomment for Ollama: http://localhost:11434/v1
# LLM_EXTRA_BODY=            # optional JSON for extra request params
# LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}  # disable thinking on DeepSeek V4

# --- OpenAI (LLM_PROVIDER=openai or custom) ---
OPENAI_API_KEY=<your-openai-api-key>

# --- Anthropic (LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
